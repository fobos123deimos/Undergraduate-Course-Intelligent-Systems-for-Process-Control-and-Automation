{% extends "default/module.html.jinja2" %}
{% block nav_title %}
    <div class="course-heading">Intelligent Systems</div>
    <div class="course-subheading">Process Control &amp; Automation<br>Python API reference</div>
    <div class="course-links">
        <a href="https://github.com/fobos123deimos/Undergraduate-Course-Intelligent-Systems-for-Process-Control-and-Automation">Course &amp; notebooks</a>
        <a href="https://github.com/fobos123deimos/Undergraduate-Course-Intelligent-Systems-for-Process-Control-and-Automation/blob/main/docs/VALIDATION.md">Validation evidence</a>
        <a href="https://github.com/fobos123deimos/Undergraduate-Course-Intelligent-Systems-for-Process-Control-and-Automation/tree/main/simulink/models">MATLAB &amp; Simulink</a>
    </div>
{% endblock %}
{% block module_info %}
{{ super() }}
{% set prefix = '../' * (module.modulename.count('.')) %}
{% if course_images.get(module.modulename) %}
<section class="visual-guide" aria-label="Illustrated guide">
  <h2>Illustrated guide</h2>
  <p>Equipment, information flow and computed evidence. Captions distinguish nonlinear records from fitted-predictor exercises.</p>
  {% for item in course_images[module.modulename] %}
  <figure>
    <a href="{{ prefix }}assets/{{ item.source }}"><img src="{{ prefix }}assets/{{ item.source }}" alt="{{ item.caption }}" loading="lazy"></a>
    <figcaption>{{ item.caption }}{% if item.link %} <a href="{{ item.link }}">Worked explanation and evidence</a>.{% endif %}</figcaption>
  </figure>
  {% endfor %}
</section>
{% endif %}
{% endblock %}
